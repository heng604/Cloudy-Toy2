# Copy to .env.local. (Your old Next.js .env.local also works as-is: NEXT_PUBLIC_* names are still read.)
# NEVER commit real values.

# --- browser (public) ---
VITE_SUPABASE_URL=https://YOUR-PROJECT-ID.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-publishable-key
# Google button is ON by default. Set to false to hide it.
VITE_GOOGLE_LOGIN=true
# Optional fallbacks for the Contact/Cart Telegram button and contact email (normally set in Admin > Settings)
VITE_TELEGRAM_URL=
VITE_ADMIN_NOTIFICATION_EMAIL=toyscloudy@gmail.com

# --- server only (never exposed to the browser) ---
SUPABASE_SERVICE_ROLE_KEY=your-supabase-secret-key
RESEND_API_KEY=your-resend-api-key
ADMIN_NOTIFICATION_EMAIL=toyscloudy@gmail.com
# IMPORTANT (so mail does NOT go to spam): verify your own domain in Resend (resend.com/domains, add the SPF + DKIM DNS records),
# then use an address on that domain, e.g. EMAIL_FROM=Cloudy-Toy <orders@yourdomain.com>.
# Gmail/Yahoo addresses cannot be used as the sender: the app falls back to Resend's test sender, which only delivers to your own Resend account email and is often marked as spam.
EMAIL_FROM=Cloudy-Toy <orders@yourdomain.com>
PORT=3001
# Bakong/KHQR (not used yet)
BAKONG_PROVIDER_API_URL=
BAKONG_MERCHANT_ID=
BAKONG_API_KEY=
BAKONG_WEBHOOK_SECRET=
